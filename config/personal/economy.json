    {"target": "currency_standards", "advances_any": ["standardized_coins", "mint_advance"], "reason": "Currency standardization"},
    {"target": "democracy", "advances_any": ["the_constitution", "separation_of_powers"], "reason": "Constitutional thought, does not change laws"},
    {"target": "international_trade", "institutions_any": ["global_trade"], "reason": "Global trade institution"},
    {"target": "banking", "advances_any": ["banking_advance"], "reason": "Banking practices"},
    {"target": "central_banking", "advances_any": ["central_bank_advance"], "reason": "Central banking"},
    {"target": "academia", "advances_any": ["university_advance"], "reason": "University institutions"},
