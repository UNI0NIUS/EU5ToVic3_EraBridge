    {"target": "empiricism", "advances_any": ["scientific_revolution_advance"], "reason": "Scientific method"},
    {"target": "central_archives", "advances_any": ["modern_bureaucracy"], "reason": "Modern administrative records"},
    {"target": "joint_stock_companies", "advances_any": ["joint_stock_companies"], "reason": "Joint stock organization"},
    {"target": "medical_degrees", "advances_any": ["medical_school_advance"], "reason": "Medical education"},
    {"target": "quinine", "advances_all": ["quinine"], "reason": "Direct medicinal analogue"},
    {"target": "egalitarianism", "advances_all": ["rights_of_man"], "reason": "Rights of man"}
  ],
